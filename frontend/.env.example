VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_BASE_PATH=/

# Supabase — required for client/employee portal direct DB queries
# Get these from Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to false to bypass Supabase Auth rate limiting (dev/demo mode).
# Set to true to use real Supabase Auth for register/login.
VITE_RATE_LIMIT_OPERATOR=true
